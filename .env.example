# ==============================================================================
# AFFECTORYX Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES OR ACTUAL CREDENTIALS.
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Application Environment: 'development', 'staging', 'production'
ENVIRONMENT=development
PROJECT_NAME="AFFECTORYX Engineering Intelligence"

# Security (CRITICAL: In production, generate a strong random 32+ char key)
# Example generation: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Database Connection
# SQLite (Local Development): sqlite:///./affactoryx.db
# PostgreSQL (Production / Docker): postgresql://affactoryx_user:affactoryx_password@localhost:5432/affactoryx
DATABASE_URL=sqlite:///./affactoryx.db

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Superuser Initial Setup (Only initialized on empty database)
FIRST_SUPERUSER_EMAIL=admin@affactoryx.internal
FIRST_SUPERUSER_PASSWORD=ChangeMeOnFirstLogin2026!

# Redis Cache & Broker (Optional in dev, required in production clustering)
REDIS_URL=redis://localhost:6379/0

# GitHub Integration (Read-only App/PAT for repository AST ingestion in Phase 2)
# Set via environment or GitHub Actions Secrets
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=
