# ==============================================================================
# AFFECTORYX Comprehensive .gitignore
# Strictly protects environment variables, credentials, databases, and build artifacts
# ==============================================================================

# Environment files and credentials (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_ed25519
secrets/
private/
credentials.json
service-account*.json

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest / Coverage
.cache
.pytest_cache/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.hypothesis/
nosetests.xml
coverage.xml
*.cover

# Database & SQLite files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
affactoryx.db

# Node / Next.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
dist/
.turbo/

# Playwright & Browser testing
test-results/
playwright-report/
blob-report/
playwright/.cache/

# OS and Editor artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Logs
logs/
*.log
